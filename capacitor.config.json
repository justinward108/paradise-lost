{
  "appId": "camp.poor.paradiselost",
  "appName": "Paradise Lost",
  "webDir": "dist/client",
  "bundledWebRuntime": false,
  "backgroundColor": "#263822",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#263822",
    "buildOptions": {
      "keystorePath": "release-key.keystore",
      "keystoreAlias": "paradise-lost"
    }
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#263822",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#263822",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#263822",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
